function find(){
 let n=document.getElementById("name").value.toLowerCase().trim();
 if(n==""){ document.getElementById("result1").innerHTML="Naam to likho pehle! 😅"; return; }
 let found="Nahi mila! Neeche wale button me se dhoondho!";
 for(let k in med){ if(n.includes(k) || k.includes(n)) found=med[k]; }
 document.getElementById("result1").innerHTML=found;
}
function find2(n){ document.getElementById("name").value=n; document.getElementById("result1").innerHTML=med[n]; window.scrollTo(0,0); }
function show(s){
 let t="";
 if(s=='bukhar') t="🤒 BUKHAR hai? Log <b>Crocin / Dolo / Calpol / Paracetamol</b> ke baare me puchte hai!";
 if(s=='sar') t="😣 SAR DARD hai? Log <b>Crocin / Combiflam / Saridon / Disprin</b> ke baare me puchte hai!";
 if(s=='sardi') t="🤧 SARDI hai? Log <b>Vicks / Cetirizine / Sinerest / Allegra</b> ke baare me puchte hai!";
 if(s=='khansi') t="😮‍💨 KHANSI hai? Log <b>Benadryl / Ascoril / Honitus / Strepsils</b> ke baare me puchte hai!";
 if(s=='pet') t="😖 PET / GAS hai? Log <b>Digene / Eno / Pan / Omez / Pudin Hara</b> ke baare me puchte hai!";
 if(s=='chot') t="🩹 CHOT lagi hai? Log <b>Betadine / Dettol / Savlon / Soframycin</b> lagate hai!";
 if(s=='loose') t="💧 LOOSE MOTION hai? Log <b>ORS / Electral / Norflox</b> ke baare me puchte hai!";
 if(s=='vitamin') t="💪 VITAMIN chahiye? Log <b>Limcee / Zincovit / Becosule / Shelcal / Chyawanprash</b> ke baare me puchte hai!";
 document.getElementById("result2").innerHTML=t+"<br><br><small>⚠️ Doctor se puch ke hi dawai lena!</small>";
}
let box=document.getElementById("allbtn");
for(let k in med){ let b=document.createElement("button"); b.className="all"; b.innerText=k.toUpperCase(); b.onclick=()=>find2(k); box.appendChild(b); }
document.getElementById("count").innerHTML="Total: "+Object.keys(med).length+" Dawaiyan! 🔥";
</script>
</body>
</html>
